CONFIG_BCM_GPS_SPI_DRIVER=y
CONFIG_FINGERPRINT_FPC_TEE=y
CONFIG_FINGERPRINT_FP_VREG_CONTROL=y
CONFIG_FINGERPRINT_GOODIX_TA=y
CONFIG_LEDS_LM3644=y
CONFIG_MACH_XIAOMI=y
CONFIG_MACH_XIAOMI_E1N=y
CONFIG_MACH_XIAOMI_SDM845=y
CONFIG_SECURE_TOUCH=y
CONFIG_TOUCHSCREEN_ATMEL_MXT=y
CONFIG_TOUCHSCREEN_ST_FTS_V521=y
CONFIG_USE_ROHM_BU64753=y
CONFIG_FINGERPRINT_FPC_SCREEN_NOTIFY=y
CONFIG_I2C_BY_DMA=y
# CONFIG_TOUCHSCREEN_ATMEL_MXT_T37 is not set
# CONFIG_TOUCHSCREEN_ST_DEBUG_FS is not set
# #115: Qualcomm WCN3990 Bluetooth over HS UART (ttyHS0)
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_HCIUART_QCA=y
CONFIG_BT_QCA=y
# Keep RT scheduling usable for com.android.bluetooth (Bluetooth HAL aborts otherwise)
# CONFIG_RT_GROUP_SCHED is not set

# #116 gaming defaults
# 300 Hz timer for lower input/scheduler latency (was 100 Hz)
# CONFIG_HZ_100 is not set
CONFIG_HZ_300=y

# Prefer deadline for UFS responsiveness over CFQ/ZEN.
# DEFAULT_IOSCHED is only the derived string; the actual Kconfig choice
# symbol must be switched from ZEN to DEADLINE.
CONFIG_IOSCHED_DEADLINE=y
CONFIG_DEFAULT_DEADLINE=y
# CONFIG_DEFAULT_ZEN is not set
# CONFIG_DEFAULT_CFQ is not set
# CONFIG_DEFAULT_NOOP is not set
CONFIG_DEFAULT_IOSCHED="deadline"

# Fair queue for BBR pacing; runtime profile sets fq_codel for Wi-Fi/UDP
CONFIG_NET_SCH_FQ=y
