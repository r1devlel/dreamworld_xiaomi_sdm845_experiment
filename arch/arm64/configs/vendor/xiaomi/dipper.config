CONFIG_BCM_GPS_SPI_DRIVER=y
CONFIG_FINGERPRINT_FPC_TEE=y
CONFIG_FINGERPRINT_FP_VREG_CONTROL=y
CONFIG_FINGERPRINT_GOODIX_TA=y
CONFIG_LEDS_LM3644=y
CONFIG_MACH_XIAOMI=y
CONFIG_MACH_XIAOMI_E1N=y
CONFIG_MACH_XIAOMI_SDM845=y
CONFIG_SECURE_TOUCH=y
CONFIG_TOUCHSCREEN_ATMEL_MXT=y
CONFIG_TOUCHSCREEN_ST_FTS_V521=y
CONFIG_USE_ROHM_BU64753=y
CONFIG_FINGERPRINT_FPC_SCREEN_NOTIFY=y
CONFIG_I2C_BY_DMA=y
# CONFIG_TOUCHSCREEN_ATMEL_MXT_T37 is not set
# CONFIG_TOUCHSCREEN_ST_DEBUG_FS is not set
# #115: Qualcomm WCN3990 Bluetooth over HS UART (ttyHS0)
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_HCIUART_QCA=y
CONFIG_BT_QCA=y
# Keep RT scheduling usable for com.android.bluetooth (Bluetooth HAL aborts otherwise)
# CONFIG_RT_GROUP_SCHED is not set

# Binderfs: enable per-ipc-namespace binder devices.
# The mount path is backported to the 4.9 legacy mount API.
CONFIG_ANDROID_BINDERFS=y

# DMA-BUF heaps: provide the userspace heap nodes expected by libdmabufheap.
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y

# #116 gaming defaults
# 300 Hz timer for lower input/scheduler latency (was 100 Hz)
# CONFIG_HZ_100 is not set
CONFIG_HZ_300=y

# Prefer deadline for UFS responsiveness over CFQ/ZEN.
# DEFAULT_IOSCHED is only the derived string; the actual Kconfig choice
# symbol must be switched from ZEN to DEADLINE.
CONFIG_IOSCHED_DEADLINE=y
CONFIG_IOSCHED_BFQ=y
# CONFIG_BFQ_GROUP_IOSCHED is not set
CONFIG_DEFAULT_DEADLINE=y
# CONFIG_DEFAULT_ZEN is not set
# CONFIG_DEFAULT_CFQ is not set
# CONFIG_DEFAULT_NOOP is not set
CONFIG_DEFAULT_IOSCHED="deadline"

# Fair queue for BBR pacing; runtime profile sets fq_codel for Wi-Fi/UDP
CONFIG_NET_SCH_FQ=y

# Multi-gen LRU (experimental, backported from the 4.9 sdm845 port).
# Enable at boot; runtime can still be disabled through
# /sys/kernel/mm/lru_gen/enabled if a regression appears.
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_NR_LRU_GENS=7
CONFIG_TIERS_PER_GEN=4

# le9uo working-set floors are part of the same backport. Keep the floors at
# zero so they are inert unless explicitly enabled through vm.*_ratio.
CONFIG_ANON_MIN_RATIO=0
CONFIG_CLEAN_LOW_RATIO=0
CONFIG_CLEAN_MIN_RATIO=0

# Sultan Alsawaf's CPU input boost + devfreq boost.
# The old CAF cpu-boost driver would register a second input handler and
# fight over the same policies, so keep it disabled.
# CONFIG_CPU_BOOST is not set
CONFIG_CPU_INPUT_BOOST=y
CONFIG_INPUT_BOOST_DURATION_MS=400
CONFIG_WAKE_BOOST_DURATION_MS=1000
CONFIG_INPUT_BOOST_FREQ_LP=1420800
CONFIG_INPUT_BOOST_FREQ_PERF=1843200
CONFIG_MAX_BOOST_FREQ_LP=1766400
CONFIG_MAX_BOOST_FREQ_PERF=2803200
CONFIG_CPU_FREQ_MIN_LP=300000
CONFIG_CPU_FREQ_MIN_PERF=300000
CONFIG_DEVFREQ_BOOST=y
CONFIG_DEVFREQ_INPUT_BOOST_DURATION_MS=400
CONFIG_DEVFREQ_WAKE_BOOST_DURATION_MS=1000
CONFIG_DEVFREQ_MSM_CPUBW_BOOST_FREQ=8132
